.DS_Store
.RData
.Rhistory
.Rproj.user/
.vscode/

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Data and generated artifacts are reproducible/local, not source code.
data/raw/*
data/cleaned/*
data/processed/*
data/synthetic/*
!data/**/.gitkeep
models/**/*
!models/**/
!models/**/.gitkeep
artifacts/metrics/*
artifacts/figures/*
artifacts/tables/*
!artifacts/**/.gitkeep
outputs/metrics/*
outputs/figures/*
outputs/tables/*
outputs/logs/*
outputs/data/*
outputs/tuning/*
outputs/predictions/*
!outputs/**/.gitkeep

# Rendered report outputs
report/_freeze/
report/_site/
report/*.html
report/*.pdf
